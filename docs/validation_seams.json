    {
      "gap_id": "GAP-1",
      "title": "Missing Ollama keep_alive and model unload support",
      "evidence_receipt": "server/src/llm/ollama.provider.js:20-42",
      "impact": "Models remain resident in GPU VRAM during multi-model test sweeps, risking out-of-memory crashes on consumer GPUs.",
      "remedy": "Add keep_alive option to request body at ollama.provider.js:28 and implement unload() method sending keep_alive: 0."
    },
    {
      "gap_id": "GAP-2",
      "title": "In-memory database handle caching prevents folder cleanup on Windows",
      "evidence_receipt": "server/src/config/registry.db.js:9-23",
      "impact": "better-sqlite3 handles cached in-process prevent deleting data-test/ folder on Windows between suites with EBUSY error.",
      "remedy": "Export resetRegistryDb() helper in registry.db.js to close open connections and clear the connection map."
    },
    {
      "gap_id": "GAP-3",
      "title": "Legacy fixture database files absent from repository",
      "evidence_receipt": "Workspace root / sample-data/",
      "impact": "Tests expecting ecommerce_test.db, college_attendance.db, U3_institute.db, chinook.db, or H3_metropol.db will fail.",
      "remedy": "Use 5 CSV files in sample-data/, generate sample-data/retail_multitable.db, or create in-memory SQLite fixtures via makeTempSqlite()."
    },
    {
      "gap_id": "GAP-4",
      "title": "Traces omit engine-level sub-steps for Document, Hybrid, and Analysis routes",
      "evidence_receipt": "server/src/core/engines/document.engine.js:42, hybrid.engine.js:63, analysis.engine.js:91",
      "impact": "Layer-isolated runner cannot attribute stage-by-stage failures for document retrieval or analysis decomposition through trace object.",
